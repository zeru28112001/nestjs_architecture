# Server Configuration
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs_architecture?schema=public"

# Authentication & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Throttler / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

